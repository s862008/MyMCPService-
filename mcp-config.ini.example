; ============================================================
;  Firebird MCP Server — ШАБЛОН конфигурационного файла
;  Скопируйте этот файл в mcp-config.ini и заполните значения.
;
;  Расположение: рядом с jar-файлом.
;  Путь можно указать: -Dconfig.file=C:\my\path\mcp-config.ini
; ============================================================

; ---------- Основной режим работы ----------
[server]
transport = stdio

; ---------- База данных Firebird 3 ----------
[database]
host = localhost
port = 3050
path = 
user = 
password = 
dialect = 1
charset = UTF8

; ---------- HTTP / SSE транспорт (transport = http) ----------
[http]
host = 0.0.0.0
port = 8080
mcp_path = /mcp
sse_path = /sse
health_path = /health
cors_origins = *
thread_pool_size = 4

; ---------- Stdio транспорт (transport = stdio) ----------
[stdio]
encoding = UTF-8

; ---------- Прочие параметры ----------
[app]
log_dir = logs
max_query_rows = 10000
max_proc_rows = 1000

; ---------- Безопасность ----------
[security]
; Таймаут выполнения SQL-запроса (setQueryTimeout), сек.
; 0 = без таймаута (не рекомендуется, может вызвать OOM/зависание).
; Применяется ко всем SELECT, DML и DDL.
query_timeout_sec = 30

; Блокировать DDL в sql_execute (CREATE/ALTER/DROP).
; false = разрешено (по умолчанию), true = заблокировано.
block_ddl = false

; Точечная блокировка DROP (самая разрушительная операция).
; CREATE/ALTER останутся разрешёнными.
block_drop = false

; Требовать WHERE у UPDATE/DELETE.
; true = массовые операции блокируются (по умолчанию),
; false = разрешено (агент может снести всю таблицу).
require_where = true
