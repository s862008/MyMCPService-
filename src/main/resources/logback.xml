<?xml version="1.0" encoding="UTF-8"?>
<!--
  Конфигурация Logback.

  ВАЖНО: все логи пишутся в STDERR, а не в STDOUT!
  В stdio-транспорте по STDOUT идёт протокольный JSON-RPC трафик —
  любая посторонняя строка (лог, стектрейс) сломает парсер клиента (Koda).
  target="System.err" переключает консольный appender на stderr.
-->
<configuration>

    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <!-- Ключевая настройка: логи в stderr, stdout остаётся чистым для MCP -->
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Файловый appender — удобно для отладки HTTP-режима -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/firebird-mcp-server.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/firebird-mcp-server.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Наш код — с отладочными сообщениями (DEBUG покажет каждый SQL и запрос) -->
    <logger name="mcp" level="DEBUG"/>

    <!-- Jaybird (драйвер Firebird) — только предупреждения и ошибки -->
    <logger name="org.firebirdsql" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="STDERR"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
